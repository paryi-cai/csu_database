# npm 配置（仅影响前端依赖安装，不修改 package.json 与任何源码）
#
# 背景：本前端是 2023 年的依赖树（@vue/cli-service 5.0.8 + webpack 5），
#       在较新的 Node/npm 下直接安装容易出现 peer 依赖与 engines 校验问题。

# 1) 按旧版语义解析 peer 依赖，避免 npm 7+ 的 ERESOLVE 报错
legacy-peer-deps=true

# 2) 即使某个包声明了 engines.node 上限（例如 @achrinza/node-ipc 只写到 node 19），
#    也只警告、不中断安装
engine-strict=false

# 3) 使用国内镜像，安装更快
registry=https://registry.npmmirror.com
