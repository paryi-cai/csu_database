<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.csu.takeout.mapper.UserMsgMapper">

    <!--
        按手机号查询用户详细信息（与 既有接口:236 的
        select * from user_msg where phone=? 等价）。

        项目全局关闭了 map-underscore-to-camel-case，因此必须逐列显式起别名，
        否则 real_name / user_name 这类下划线列名映射不到实体属性上
        （原先只给 real_name 与 user_name 起了别名，其余列名恰好与属性名同形才正常）。
    -->
    <select id="getByPhone" resultType="com.csu.takeout.entity.UserMsg">
        select id        as id,
               real_name as realName,
               sex       as sex,
               age       as age,
               mail      as mail,
               phone     as phone,
               user_name as userName
        from user_msg
        where phone = #{phone}
        limit 1
    </select>

    <!--
        修改个人信息：按 phone 定位记录（与查询同一把钥匙，保证"查得到就改得到"）。
        phone 与 id 都不在更新列里：前者是查询键、后者是外键关联列，都不允许改。

        注意取值的写法是 #{dto.xxx}：方法上有两个 @Param（phone 与 dto），
        MyBatis 会把它们放进一个 ParamMap，**不会**把 dto 的属性平铺到顶层，
        因此写 #{userName} 会抛 BindingException: Parameter 'userName' not found。
    -->
    <update id="updateByPhone">
        update user_msg
        set user_name = #{dto.userName},
            real_name = #{dto.realName},
            sex       = #{dto.sex},
            age       = #{dto.age},
            mail      = #{dto.mail}
        where phone = #{phone}
    </update>

</mapper>
