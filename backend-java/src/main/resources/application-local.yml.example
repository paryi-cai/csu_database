# 复制本文件为 application-local.yml 后填入真实值。
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库。
#
# 说明：application.yml 中的默认值已经能连上 docker compose 起的 MySQL(3307) / Redis(6379)，
#       通常无需本文件。只有在需要覆盖默认值或改用其他环境时才创建它。

spring:
  datasource:
    druid:
      url: jdbc:mysql://localhost:3307/caimingxuan?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
      username: root
      password: "你的数据库密码"
  data:
    redis:
      host: localhost
      port: 6379

csu:
  jwt:
    # JWT 签名密钥（生产环境务必改为强密钥；容器编排的默认值见 docker-compose.yml 的 JWT_SECRET）
    secret-key: 你的JWT密钥
